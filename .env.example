# Postgres local para desarrollo (ver README).
#  - Postgres del sistema (puerto 5432): la cadena de abajo tal cual.
#  - Docker (npm run db:up): postgres://ceeps:ceeps@localhost:5433/torneos
# En Vercel va la cadena del Transaction pooler de Supabase (puerto 6543).
DATABASE_URL=postgres://ceeps:ceeps@localhost:5432/torneos
# Secreto para firmar las cookies de sesión (openssl rand -base64 32)
SESSION_SECRET=
# Correos que pueden entrar al panel /admin, separados por comas
ADMIN_EMAILS=
# Contraseña común del panel /admin (sin comillas)
ADMIN_PASSWORD=
