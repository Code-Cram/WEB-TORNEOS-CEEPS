# Copia este fichero como .env.supabase (no se sube a git) y pega la cadena del "Session pooler" de Supabase
# (Connect → Session pooler, puerto 5432). Si la contraseña tiene símbolos, codifícalos
# (@ → %40, # → %23, $ → %24, / → %2F, ? → %3F, % → %25).
DATABASE_URL=postgresql://postgres.TU-PROYECTO:TU-CONTRASEÑA@aws-0-eu-west-1.pooler.supabase.com:5432/postgres
