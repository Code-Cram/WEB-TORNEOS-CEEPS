{
  "name": "torneos-ceeps",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "tsx scripts/migrar.mts --solo-en-vercel && next build",
    "start": "next start",
    "lint": "eslint",
    "db:up": "docker compose up -d",
    "db:push": "drizzle-kit push --force",
    "db:migrar": "tsx --env-file=.env.local scripts/migrar.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "db:demo": "tsx --env-file=.env.local scripts/demo.mts",
    "supabase:push": "ENV_FILE=.env.supabase drizzle-kit push",
    "supabase:seed": "tsx --env-file=.env.supabase scripts/seed.mts"
  },
  "dependencies": {
    "@vercel/functions": "^3.10.3",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.13",
    "next": "16.4.2",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
